        "stage": "complete",
        "locale": "ruRU",
        "gender": "unknown",
        "npc_id": 135154,
        "text": "Эти корни – именно то, что нужно.",
        "speaker": "Киро",
        "npc_race": "",
        "npc_type": "",
        "npc_gender": ""
