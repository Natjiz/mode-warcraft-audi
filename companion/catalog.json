    {
      "request": {
        "quest_id": 50913,
        "stage": "complete",
        "locale": "ruRU",
        "gender": "unknown",
        "npc_id": 128152,
        "text": "Если захочешь получить мой дар, обратись ко мне в святилище, построенном в мою честь.",
        "speaker": "Акунда",
        "npc_race": "",
        "npc_type": "",
        "npc_gender": ""
      },
      "url": "https://raw.githubusercontent.com/Natjiz/mode-warcraft-audi/main/assets/akunda_streamed/complete.ogg",
