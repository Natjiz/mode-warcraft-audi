        "locale": "ruRU",
        "gender": "unknown",
        "npc_id": 128152,
        "text": "Я благословляю своих последователей.",
        "speaker": "Акунда",
        "npc_race": "",
        "npc_type": "",
        "npc_gender": ""
      },
      "url": "https://raw.githubusercontent.com/Natjiz/mode-warcraft-audi/main/assets/akunda_streamed/progress.ogg",
